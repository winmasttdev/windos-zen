# windOS Zen — GNOME dconf keyfile (Module 5)
# Installed to /etc/dconf/db/local.d/00-windos and compiled with dconf update
# Format: dconf KEYFILE (path-based, not dump format)
[/org/gnome/desktop/interface]
gtk-theme='Arc-Dark'
icon-theme='Papirus-Dark'
cursor-theme='Adwaita'
font-name='Plus Jakarta Sans 10'
document-font-name='Plus Jakarta Sans 10'
monospace-font-name='JetBrains Mono 10'
color-scheme='prefer-dark'
accent-color='blue'

[/org/gnome/desktop/background]
picture-uri='file:///usr/share/wallpapers/windos-zen-1920x1080.png'
picture-uri-dark='file:///usr/share/wallpapers/windos-zen-1920x1080.png'
picture-options='zoom'

[/org/gnome/desktop/wm/preferences]
theme='Arc-Dark'
titlebar-font='Plus Jakarta Sans Bold 10'

[/org/gnome/shell]
enabled-extensions=['dash-to-dock@micxgx.gmail.com', 'blur-my-shell@aunetx', 'appindicatorsupport@rgcjonas.gmail.com', 'user-theme@gnome-shell-extensions.gcampax.github.com']
favorite-apps=['firefox-esr.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Terminal.desktop']

[/org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
dash-max-icon-size=40
transparency-mode='DYNAMIC'
background-opacity=0.7

[/org/gnome/shell/extensions/blur-my-shell]
brightness=0.6
sigma=30
