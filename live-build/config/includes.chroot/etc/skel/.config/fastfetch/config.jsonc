{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "data-raw",
        "source": "      .-========-.\n      |  \\    /  |\n      |   \\  /   |\n      |    \\/    |\n      |    /\\    |\n      |   /  \\   |\n      |  /    \\  |\n      '-========-'\n       windOS Zen",
        "padding": {
            "top": 1,
            "left": 1
        }
    },
    "display": {
        "separator": ": "
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        {
            "type": "kernel",
            "format": "{release}"
        },
        "uptime",
        "packages",
        "shell",
        "de",
        "wm",
        "terminal",
        "cpu",
        {
            "type": "memory",
            "format": "{} / {}"
        },
        "break",
        "colors"
    ]
}
