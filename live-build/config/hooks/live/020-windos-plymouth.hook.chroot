#!/bin/sh
# ============================================================================
#  windOS Zen — chroot hook 020: Plymouth theme registration (Module 2)
#  The theme *files* arrive via config/includes.chroot/usr/share/plymouth/
#  themes/windos-zen/ — this hook only wires them into the system.
# ============================================================================
set -e

THEME_DIR=/usr/share/plymouth/themes/windos-zen
THEME_DESC="$THEME_DIR/windos-zen.plymouth"

[ -f "$THEME_DESC" ] || { echo "windos-zen theme missing!" >&2; exit 1; }

# --- make it THE default theme (alternatives + plymouthd.conf) ---------------
update-alternatives --install /usr/share/plymouth/themes/default.plymouth \
    default.plymouth "$THEME_DESC" 100
update-alternatives --set     default.plymouth "$THEME_DESC"

if [ -f /etc/plymouth/plymouthd.conf ]; then
    sed -i 's/^Theme=.*/Theme=windos-zen/' /etc/plymouth/plymouthd.conf
    grep -q '^Theme=' /etc/plymouth/plymouthd.conf \
        || echo 'Theme=windos-zen' >> /etc/plymouth/plymouthd.conf
else
    printf '[Daemon]\nTheme=windos-zen\n' > /etc/plymouth/plymouthd.conf
fi

# --- flicker-free kernel cmdline for installed systems ------------------------
WINDOS_CMDLINE='quiet splash loglevel=3 rd.udev.log_priority=3 vt.global_cursor_default=0'
if [ -f /etc/default/grub ]; then
    sed -i "s|^GRUB_CMDLINE_LINUX_DEFAULT=.*|GRUB_CMDLINE_LINUX_DEFAULT=\"$WINDOS_CMDLINE\"|" \
        /etc/default/grub
fi

# --- dracut users (installed systems that replaced initramfs-tools) ----------
if command -v dracut >/dev/null 2>&1; then
    mkdir -p /etc/dracut.conf.d
    cat > /etc/dracut.conf.d/99-windos-zen.conf <<'EOF'
# windOS Zen: splash in the initramfs, no debug noise
omit_dracutmodules+=" debug "
add_dracutmodules+=" plymouth "
kernel_cmdline="quiet splash loglevel=3 rd.udev.log_priority=3 vt.global_cursor_default=0"
EOF
fi

# NOTE: the live initramfs itself is regenerated by live-build's binary stage
# (initramfs-tools), which picks the theme up from the alternatives symlink
# via the stock /usr/share/initramfs-tools/hooks/plymouth hook.
# (Our belt-and-braces copy lives in
# includes.chroot/etc/initramfs-tools/hooks/plymouth-windos-zen.)
exit 0
