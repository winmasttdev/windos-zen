# ===========================================================================
#  windOS Zen — Plymouth boot splash (script plugin)
#  "Lighter Than Air"
#
#  Design rules we obey on potato GPUs:
#    * every visual is a pre-rendered PNG blit (generated by
#      tools/gen-assets.sh) — no vector work, no text rendering at boot
#    * three animated things only: a 600 ms fade-in, a 24-frame spinner
#      (20 fps) and a 40-segment quantised progress bar (opacity flips)
#    * background is a flat two-stop gradient painted once by the window,
#      or an exact-resolution PNG when we recognise the framebuffer size
#    * no per-frame allocations: all sprites are created once at load
#
#  Plymouth script-plugin notes (verified against upstream source,
#  src/plugins/splash/script/ in plymouth 24.004.60 = Debian trixie):
#    * Window exposes ONLY GetX/GetY/GetWidth/GetHeight (+ SetX/SetY and
#      the background colour setters) — there is NO GetScreenWidth/Height.
#    * refresh callbacks are invoked with ZERO arguments — keep your own
#      clock (FRAME counter driven by SetRefreshRate).
#    * boot-progress callback signature is (duration, progress), in that
#      order. display_password is (prompt, bullets) where bullets is the
#      TOTAL count to show, not a per-keystroke delta. display_message /
#      hide_message take ONE string argument; quit takes none.
#    * there is NO Plymouth.SetHidePasswordFunction; the daemon calls the
#      display-normal handler when a prompt ends — clear secrets there.
#    * single `|` is the object-merge operator, NOT boolean OR — use `||`.
#    * the COMPLETE Plymouth.* surface (script_add_native_function calls
#      in script-lib-plymouth.c) is: SetRefreshFunction, SetRefreshRate,
#      SetBootProgressFunction, SetRootMountedFunction,
#      SetKeyboardInputFunction, SetUpdateStatusFunction,
#      SetDisplayNormalFunction, SetDisplayPasswordFunction,
#      SetDisplayQuestionFunction, SetDisplayPromptFunction,
#      SetDisplayHotplugFunction, SetValidateInputFunction,
#      SetDisplayMessageFunction, SetHideMessageFunction, SetQuitFunction,
#      SetSystemUpdateFunction, GetCapslockState, GetMode.
#      Plymouth.SetMessageFunction exists only as a compatibility alias
#      (`Plymouth.SetMessageFunction = Plymouth.SetDisplayMessageFunction`
#      in script-lib-plymouth.script) — the canonical name is the latter.
#
#  Assets expected next to this file (see windos-zen.plymouth ImageDir):
#    windos-lockup.png            512x300  cloud + wordmark, centred
#    background-1920-1080.png     exact-res backgrounds (optional)
#    background-1366-768.png
#    background-1024-768.png
#    spinner/spinner-00.png .. spinner/spinner-23.png   (96 px)
#    bar-track.png bar-seg.png bar-seg-cap.png          (progress bar)
#    pw-dot.png                                           (password bullets)
# ===========================================================================

# ---------------------------------------------------------------- palette --
BG_TOP_R = 0.043;  BG_TOP_G = 0.066;  BG_TOP_B = 0.125;   # #0b1120
BG_BOT_R = 0.020;  BG_BOT_G = 0.027;  BG_BOT_B = 0.051;   # #05070d

# ------------------------------------------------------------ helpers ------
fun pad2(n) {
    if (n < 10) return "0" + n;
    return "" + n;
}

fun clamp01(v) {
    if (v < 0) return 0;
    if (v > 1) return 1;
    return v;
}

# ----------------------------------------------------------------- screen --
# Window.GetX/GetY are the display origin (0,0 on single-head live boots).
SCREEN_X = Window.GetX();
SCREEN_Y = Window.GetY();
SCREEN_W = Window.GetWidth();
SCREEN_H = Window.GetHeight();

Window.SetBackgroundTopColor(BG_TOP_R, BG_TOP_G, BG_TOP_B);
Window.SetBackgroundBottomColor(BG_BOT_R, BG_BOT_G, BG_BOT_B);

# exact-resolution background if we shipped one; gradient otherwise
HAVE_BG = 0;
if (SCREEN_W == 1920 && SCREEN_H == 1080) { BG_IMG = Image("background-1920-1080.png"); HAVE_BG = 1; }
if (SCREEN_W == 1366 && SCREEN_H == 768)  { BG_IMG = Image("background-1366-768.png");  HAVE_BG = 1; }
if (SCREEN_W == 1024 && SCREEN_H == 768)  { BG_IMG = Image("background-1024-768.png");  HAVE_BG = 1; }
if (HAVE_BG == 1) { BG_SPRITE = Sprite(BG_IMG); BG_SPRITE.SetZ(-10); }

# ------------------------------------------------------------------- art ---
LOCKUP     = Image("windos-lockup.png");
LOCKUP_W   = LOCKUP.GetWidth();
LOCKUP_H   = LOCKUP.GetHeight();
LOCKUP_SPR = Sprite(LOCKUP);
LOCKUP_SPR.SetZ(10);

BAR_TRACK  = Sprite(Image("bar-track.png"));
BAR_TRACK.SetZ(10);

SEG_IMG    = Image("bar-seg.png");
CAP_IMG    = Image("bar-seg-cap.png");
BAR_SEGS   = 40;
BAR_X0     = SCREEN_X + SCREEN_W / 2 - 160;   # 40 segs x 8 px pitch = 320
BAR_Y      = SCREEN_Y + SCREEN_H / 2 + 168;

i = 0;
while (i < BAR_SEGS) {
    if (i == 0 || i == BAR_SEGS - 1) { BAR_SPR[i] = Sprite(CAP_IMG); }
    else                             { BAR_SPR[i] = Sprite(SEG_IMG); }
    BAR_SPR[i].SetX(BAR_X0 + i * 8);
    BAR_SPR[i].SetY(BAR_Y);
    BAR_SPR[i].SetZ(11);
    BAR_SPR[i].SetOpacity(0);
    i = i + 1;
}

SPIN_FRAMES = 24;
i = 0;
while (i < SPIN_FRAMES) {
    SPIN_IMG[i] = Image("spinner/spinner-" + pad2(i) + ".png");
    i = i + 1;
}
SPIN_SPR = Sprite(SPIN_IMG[0]);
SPIN_SPR.SetZ(12);

# password bullets: pre-create the full row once, toggle opacity per
# callback — no allocation inside the event handler.
DOT_IMG  = Image("pw-dot.png");
PW_MAX   = 32;
i = 0;
while (i < PW_MAX) {
    PW_SPR[i] = Sprite(DOT_IMG);
    PW_SPR[i].SetX(SCREEN_X + SCREEN_W / 2 - 192 + i * 12);
    PW_SPR[i].SetY(SCREEN_Y + SCREEN_H / 2 + 216);
    PW_SPR[i].SetZ(13);
    PW_SPR[i].SetOpacity(0);
    i = i + 1;
}
PW_OPEN  = 0;

# ------------------------------------------------- boot message line --------
# WHY THIS IS ALL GUARDED (details support, investigated end to end):
#
# 1. ESC "details" mode is NOT a theme feature, it is a plymouth-daemon
#    feature. main.c: on_escape_pressed() -> toggle_between_splash_and_details()
#    -> hide_splash() + ply_boot_splash_free() (i.e. THIS script is torn
#    down, quit_callback runs) -> show_detailed_splash() -> the daemon opens
#    its own details splash (details.so) and replays the messages it buffered
#    in on_display_message() via show_messages(). Nothing in a .script theme
#    is consulted, so there is nothing here to implement — and nothing we
#    could implement, because the theme object is already freed by then.
#
# 2. The script plugin has no text widget, but it does have one text ENTRY
#    point: Image.Text(text, r, g, b, a, font, align) (script-lib-image.script
#    -> native Image._Text in script-lib-image.c). It rasterises through
#    ply_label_*(), which loads a label plugin: label-pango.so, else
#    label-freetype.so (ply_label_load_plugin in
#    src/libply-splash-graphics/ply-label.c). Debian's plymouth package ships
#    NEITHER — /usr/lib/<triplet>/plymouth/ contains only details.so,
#    script.so, text.so, tribar.so and renderers/{drm,frame-buffer}.so — so
#    here Image.Text() returns a 0x0 buffer. (It cannot crash: every
#    ply_label_* entry point NULL-checks its plugin interface.)
#
# So: probe the platform ONCE, at load, and use real text rendering only on a
# plymouth that can actually rasterise. On windOS Zen the probe costs two
# failed dlopen()s and the message callbacks stay no-ops — matching the
# "pre-rendered blits only, no text rendering at boot" rule above. The probe
# also self-disables if a rasteriser ever disappears mid-boot.
#
# On any such build a boot message is drawn as a single centred line under
# the progress bar (no per-frame rasterisation: the image is built once per
# distinct message string, then faded in on our own clock), and the spinner
# is suppressed while a message is on screen — something is being named, so
# the "still waiting" animation has nothing left to say.
MSG_TEXT_OK = 0;
MSG_TEXT    = "";
MSG_OPEN    = 0;
MSG_ALPHA   = 0;
MSG_TEXT_Y  = SCREEN_Y + SCREEN_H / 2 + 200;   # below the bar
MSG_SPR     = Sprite();                         # empty sprite: the draw
MSG_SPR.SetZ(14);                               # loop skips image-less
MSG_SPR.SetOpacity(0);                          # sprites (`if (!sprite->image)`)

# Probe on its own statement pair (never `Image.Text(...).GetWidth()`:
# chained access on a call result is the one pongo construct this theme has
# no reason to be the first user of).
MSG_PROBE   = Image.Text("Ag", 0.94, 0.97, 1.0, 1.0, NULL, "left");
MSG_PROBE_W = MSG_PROBE.GetWidth();
if (MSG_PROBE_W > 0) { MSG_TEXT_OK = 1; }

# --------------------------------------------------------------- layout ----
LOCKUP_SPR.SetX(SCREEN_X + SCREEN_W / 2 - LOCKUP_W / 2);
LOCKUP_SPR.SetY(SCREEN_Y + SCREEN_H / 2 - LOCKUP_H / 2 - 60);
SPIN_SPR.SetX(SCREEN_X + SCREEN_W / 2 - 48);
SPIN_SPR.SetY(SCREEN_Y + SCREEN_H / 2 + 96);
BAR_TRACK.SetX(SCREEN_X + SCREEN_W / 2 - 200);   # 400 px track, centred
BAR_TRACK.SetY(BAR_Y);

# ------------------------------------------------------------- state -------
# The refresh handler gets no time argument, so we keep our own clock:
# FRAME driven at REFRESH_HZ; t = FRAME / REFRESH_HZ seconds since splash.
REFRESH_HZ = 30;
Plymouth.SetRefreshRate(REFRESH_HZ);
FRAME      = 0;
BOOT_PROG  = 0;
LAST_SEG_SHOWN = -1;
LAST_SPIN_IDX  = -1;

# ------------------------------------------------------------ callbacks ----
# Engine calls this as (duration, progress) — order matters.
fun boot_progress_callback(duration, progress) {
    BOOT_PROG = clamp01(progress);
}

fun refresh_callback() {
    FRAME = FRAME + 1;
    t = FRAME / REFRESH_HZ;

    # 600 ms fade-in, eased (cheap quadratic)
    a = clamp01(t / 0.6);
    alpha = a * (2 - a);

    LOCKUP_SPR.SetOpacity(alpha);
    BAR_TRACK.SetOpacity(alpha * 0.9);

    # spinner: 20 fps content on a 30 Hz clock, hidden until fade-in
    # is half done, and suppressed while a boot message is on screen
    if (alpha > 0.5 && MSG_OPEN == 0) {
        idx = Math.Int(FRAME * 20 / REFRESH_HZ) % SPIN_FRAMES;
        if (idx != LAST_SPIN_IDX) {
            SPIN_SPR.SetImage(SPIN_IMG[idx]);
            LAST_SPIN_IDX = idx;
        }
        SPIN_SPR.SetOpacity(alpha);
    } else {
        SPIN_SPR.SetOpacity(0);
    }

    # message line: 300 ms fade in / 200 ms fade out, stepped on our own
    # clock. No allocation, no rasterisation inside the refresh handler.
    if (MSG_OPEN == 1 && MSG_TEXT_OK == 1) {
        if (MSG_ALPHA < 1) { MSG_ALPHA = Math.Min(1, MSG_ALPHA + 1 / 9); }
    } else if (MSG_ALPHA > 0) {
        MSG_ALPHA = Math.Max(0, MSG_ALPHA - 1 / 6);
    }
    MSG_SPR.SetOpacity(MSG_ALPHA);

    # quantised progress bar: flip segment opacity, nothing else
    shown = Math.Int(BOOT_PROG * BAR_SEGS);
    if (shown != LAST_SEG_SHOWN) {
        i = 0;
        while (i < BAR_SEGS) {
            if (i < shown) { BAR_SPR[i].SetOpacity(alpha); }
            else           { BAR_SPR[i].SetOpacity(0); }
            i = i + 1;
        }
        LAST_SEG_SHOWN = shown;
    }
}

# password dialog: a script theme has no reliable way to label the prompt
# (see the Image.Text investigation above), so we echo bullets as dots under
# the spinner — enough to know the prompt is live.
# `bullets` is the TOTAL count to display; render exactly that many.
fun display_password_callback(prompt, bullets) {
    PW_OPEN = 1;
    n = Math.Int(bullets);
    if (n < 0) { n = 0; }
    if (n > PW_MAX) { n = PW_MAX; }
    i = 0;
    while (i < PW_MAX) {
        if (i < n) { PW_SPR[i].SetOpacity(1); }
        else       { PW_SPR[i].SetOpacity(0); }
        i = i + 1;
    }
}

# No SetHidePasswordFunction exists in the script plugin: the daemon calls
# the display-normal handler when a prompt ends, so secrets are cleared here.
fun display_normal_callback() {
    if (PW_OPEN == 1) {
        i = 0;
        while (i < PW_MAX) { PW_SPR[i].SetOpacity(0); i = i + 1; }
        PW_OPEN = 0;
    }
}

# boot messages: windOS Zen boots quiet, so the default is silence. The
# callbacks stay REGISTERED (both Plymouth.SetDisplayMessageFunction and
# Plymouth.SetHideMessageFunction are real — see the API list in the header)
# because unregistering them would not make plymouth any quieter: the daemon
# buffers every message itself (on_display_message in main.c) whether or not
# a theme listens, which is exactly what makes ESC-details work.
#
# On a plymouth without a label plugin (i.e. ours: no label-pango.so, no
# label-freetype.so) there is nothing to draw with and these two return at
# once — see the "boot message line" note above for the full investigation.
# On a plymouth that CAN rasterise, one message becomes one centred line
# under the bar, and the spinner stops until the message is hidden.
fun display_message_callback(message) {
    if (MSG_TEXT_OK == 0) { return; }
    if (message == "") { MSG_OPEN = 0; return; }              # nothing to draw
    if (message == MSG_TEXT && MSG_OPEN == 1) { return; }   # redelivery

    MSG_IMG = Image.Text(message, 0.90, 0.94, 1.0, 1.0, NULL, "center");
    MSG_W = MSG_IMG.GetWidth();
    if (MSG_W <= 0) { MSG_TEXT_OK = 0; return; }            # rasteriser gone

    MSG_TEXT = message;
    MSG_OPEN = 1;
    MSG_SPR.SetImage(MSG_IMG);
    MSG_SPR.SetX(SCREEN_X + SCREEN_W / 2 - MSG_W / 2);
    MSG_SPR.SetY(MSG_TEXT_Y);
}

# The daemon hides messages in the order it showed them, so only the line
# currently on screen may be cleared.
fun hide_message_callback(message) {
    if (MSG_TEXT_OK == 0) { return; }
    if (message != MSG_TEXT) { return; }
    MSG_OPEN = 0;                    # refresh_callback fades it out
}

# quit_callback: takes ZERO arguments (script-lib-plymouth.c calls it via
# script_execute_object with no parameters) and runs on stop_script_animation,
# which the script plugin calls from BOTH hide_splash_screen() (ESC, timeout,
# daemon switch) and destroy_plugin() — i.e. exactly once, immediately before
# one final sprite refresh. So blanking every sprite here is not just tidy, it
# IS the teardown: the last frame the user can ever see is black, with no
# half-faded lockup or a stuck password bullet left on the VT.
fun quit_callback() {
    LOCKUP_SPR.SetOpacity(0);
    SPIN_SPR.SetOpacity(0);
    BAR_TRACK.SetOpacity(0);
    i = 0;
    while (i < BAR_SEGS) { BAR_SPR[i].SetOpacity(0); i = i + 1; }
    i = 0;
    while (i < PW_MAX) { PW_SPR[i].SetOpacity(0); i = i + 1; }
    MSG_SPR.SetOpacity(0);
    MSG_OPEN = 0;
    MSG_ALPHA = 0;
    PW_OPEN = 0;
}

# ------------------------------------------------------------- register ----
Plymouth.SetBootProgressFunction(boot_progress_callback);
Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
Plymouth.SetQuitFunction(quit_callback);
