/* ===========================================================================
   windOS Zen — Calamares stylesheet (Qt5 QSS)
   Dark Fluent-ish: #090d16 surfaces, #121826 raised, #38bdf8 accent,
   8-10 px radii, no gradients heavier than two stops.
   =========================================================================== */

/* --- application chrome -------------------------------------------------- */
QWidget {
    background-color: #090d16;
    color: #e2e8f0;
    font-family: "Plus Jakarta Sans", "DejaVu Sans", sans-serif;
    font-size: 10pt;
    selection-background-color: #164e63;
    selection-color: #e0f2fe;
}

QMainWindow, QDialog, #CalamaresUtils__Widget {
    background-color: #090d16;
}

/* --- sidebar (steps list) -------------------------------------------------- */
#sidebarApp, QListView#sidebarApp {
    background-color: #090d16;
    border: none;
    padding: 8px 0;
}
QListView::item {
    color: #94a3b8;
    padding: 9px 14px;
    border-left: 3px solid transparent;
    background: transparent;
}
QListView::item:selected {
    color: #38bdf8;
    background-color: #121826;
    border-left: 3px solid #38bdf8;
}
QListView::item:hover:!selected {
    color: #cbd5e1;
    background-color: #0d1322;
}

/* --- buttons ---------------------------------------------------------------- */
QPushButton {
    background-color: #121826;
    color: #e2e8f0;
    border: 1px solid #1e293b;
    border-radius: 8px;
    padding: 7px 18px;
    min-height: 20px;
}
QPushButton:hover {
    background-color: #16233c;
    border-color: #38bdf8;
}
QPushButton:pressed {
    background-color: #0b1120;
}
QPushButton:default {
    background-color: #38bdf8;
    color: #04121c;
    border: 1px solid #38bdf8;
    font-weight: 600;
}
QPushButton:default:hover {
    background-color: #7dd3fc;
}
QPushButton:disabled {
    background-color: #0d1322;
    color: #475569;
    border-color: #1e293b;
}

/* --- inputs ------------------------------------------------------------------ */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QTextEdit, QPlainTextEdit {
    background-color: #0d1322;
    color: #e2e8f0;
    border: 1px solid #1e293b;
    border-radius: 6px;
    padding: 5px 8px;
    min-height: 20px;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus, QTextEdit:focus {
    border: 1px solid #38bdf8;
}
QComboBox::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView {
    background-color: #0d1322;
    border: 1px solid #1e293b;
    selection-background-color: #164e63;
}

/* --- checkboxes / radios ------------------------------------------------------ */
QCheckBox, QRadioButton { spacing: 8px; color: #cbd5e1; background: transparent; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px; height: 16px;
    border: 1px solid #334155;
    background: #0d1322;
}
QCheckBox::indicator { border-radius: 4px; }
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #38bdf8;
    border-color: #38bdf8;
}

/* --- lists / trees / tables ----------------------------------------------------- */
QListView, QTreeView, QTableView, QColumnView {
    background-color: #0d1322;
    alternate-background-color: #0f1626;
    border: 1px solid #1e293b;
    border-radius: 6px;
}
QHeaderView::section {
    background-color: #121826;
    color: #94a3b8;
    border: none;
    border-bottom: 1px solid #1e293b;
    padding: 6px 8px;
}

/* --- progress --------------------------------------------------------------------- */
QProgressBar {
    background-color: #0d1322;
    border: none;
    border-radius: 5px;
    height: 10px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    background-color: #38bdf8;
    border-radius: 5px;
}

/* --- scrollbars: thin, quiet -------------------------------------------------------- */
QScrollBar:vertical {
    background: transparent; width: 10px; margin: 2px;
}
QScrollBar::handle:vertical {
    background: #334155; border-radius: 4px; min-height: 28px;
}
QScrollBar::handle:vertical:hover { background: #38bdf8; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar:horizontal {
    background: transparent; height: 10px; margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #334155; border-radius: 4px; min-width: 28px;
}
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* --- tabs (partitioning etc.) ---------------------------------------------------------- */
QTabWidget::pane { border: 1px solid #1e293b; border-radius: 6px; }
QTabBar::tab {
    background: #0d1322; color: #94a3b8;
    padding: 7px 16px; border: none;
}
QTabBar::tab:selected { background: #121826; color: #38bdf8; }

/* --- tooltips ------------------------------------------------------------------------------ */
QToolTip {
    background-color: #121826;
    color: #e2e8f0;
    border: 1px solid #38bdf8;
    border-radius: 4px;
    padding: 4px 8px;
}

/* --- group boxes / labels ------------------------------------------------------------------- */
QGroupBox {
    border: 1px solid #1e293b;
    border-radius: 8px;
    margin-top: 14px;
    padding-top: 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    color: #38bdf8;
}
QLabel { background: transparent; border: none; color: #e2e8f0; }
QLabel#appLogoLabel { background: transparent; }
