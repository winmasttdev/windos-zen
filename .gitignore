# ============================================================================
#  windOS Zen — build artifacts. Nothing in this file is source.
#  The ISO, the build chroot and the logs are produced locally on the builder;
#  they are never committed (they are large, and some are machine-specific).
# ============================================================================

# --- ISO images and disk images ----------------------------------------------
# NEVER commit a built image. Releases are published from the Releases page.
*.iso
*.qcow2
*.img
*.vdi
*.vmdk

# --- live-build runtime (Debian live-build) -----------------------------------
# The build chroot is a full Debian root filesystem (~14 GB), the cache is a
# bootstrap rootfs, and binary/ is the assembled ISO payload.
live-build/chroot/
live-build/cache/
live-build/binary/
live-build/local/
# live-build's own stage bookkeeping: zero-byte marker files + symlinks that
# record which stages have already run. Generated on every `lb build`.
live-build/.build/
# live-build's generated chroot package manifests
/live-build/chroot.packages.*
# per-image manifests + checksums, regenerated by every build
/live-build/*.files
/live-build/*.contents
/live-build/*.packages
/live-build/SHA256SUMS
/live-build/binary.modified_timestamps

# --- scratch and logs ----------------------------------------------------------
# build-iso.sh pipes `lb build` through `tee build.log`
*.log
docker-build.log
# in-progress ISO written by xorriso
*.tmp
# scratch media produced while cutting the vertical short
*.ppm
*.pgm
*.pbm

# --- QEMU / VM scratch ---------------------------------------------------------
# unix sockets, monitor sockets and pidfiles from local test boots
*.sock
*.pid
qemu-*.serial
/var-lib/
*.pidfile

# --- credentials ---------------------------------------------------------------
# Never commit private keys, tokens or apt secrets.
# Note: live-build/config/archives/liquorix.key.chroot is NOT matched by these
# patterns and is checked in on purpose — it is the public Liquorix repository
# signing key, vendored so the build chroot can pin signed-by= against it.
*.pem
*.key
.netrc
.netrc-*
.htpasswd
secrets.*
*.secret
*.token
credentials.json

# --- Python --------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
*.egg-info/
.venv/
venv/

# --- editor / OS junk ----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.orig
*.rej

# --- older build layouts kept around by the pivot from the airootfs recipe ---
/airootfs/
/out/
/work/