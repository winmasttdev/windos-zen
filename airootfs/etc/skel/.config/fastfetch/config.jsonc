{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/windos/logo-ascii.txt",
    "padding": { "top": 1, "right": 4 }
  },
  "general": {
    "separator": ":",
    "color": { "type": "auto" }
  },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}", "color": "blue" },
    { "type": "separator" },
    { "type": "os", "key": "OS", "format": "windOS Zen" },
    { "type": "host", "key": "Host" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "uptime", "key": "Uptime" },
    { "type": "packages", "key": "Packages" },
    { "type": "shell", "key": "Shell" },
    { "type": "wm", "key": "WM" },
    { "type": "resolution", "key": "Resolution" },
    { "type": "cpu", "key": "CPU" },
    { "type": "memory", "key": "Memory" },
    { "type": "colors", "key": "Palette", "symbol": "block" }
  ]
}
